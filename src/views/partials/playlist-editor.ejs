<%
// Playlist editor modal — included once per page (in admin-playlists, and in
// post-edit when present). Exposes `window.openPlaylistEditor({ mode, id?, onSaved? })`.
//
//   mode: 'create' or 'edit'
//   id  : (edit only) playlist id to load
//   onSaved: callback receiving { id, playlist } — used by post-editor
//            to insert [[playlist:id]] at the cursor.
//
// The modal itself is appended on first call; subsequent calls reuse the
// same DOM. CSS is included once. JS lives below.

const _csrf = (typeof csrfToken !== 'undefined' && csrfToken) || '';
%>

<style>
/* ─── Editor modal ─────────────────────────────────────────────── */
.pl-modal-backdrop {
  position: fixed; inset: 0; z-index: 9000;
  background: color-mix(in srgb, #000 50%, transparent);
  display: flex; align-items: center; justify-content: center;
  padding: 1rem;
  -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px);
}
.pl-modal {
  background: var(--paper);
  border: 1px solid var(--rule); border-radius: 16px;
  width: 100%; max-width: 960px;
  max-height: 92vh;
  display: flex; flex-direction: column;
  box-shadow: 0 24px 60px rgba(0, 0, 0, .35);
  overflow: hidden;
}
.pl-modal-header {
  padding: 1rem 1.25rem;
  border-bottom: 1px solid var(--rule);
  display: flex; align-items: center; justify-content: space-between;
}
.pl-modal-header h3 { margin: 0; font-size: 1.15rem; }
.pl-modal-close {
  background: transparent; border: 0;
  font-size: 1.5rem; line-height: 1; cursor: pointer;
  width: 36px; height: 36px; border-radius: 8px;
  display: inline-flex; align-items: center; justify-content: center;
  color: var(--ink-soft);
}
.pl-modal-close:hover { background: var(--paper-2); color: var(--ink); }
.pl-modal-body {
  flex: 1 1 auto; min-height: 0;
  overflow: hidden;
  padding: 1.25rem;
  /* Become a flex container so .pl-editor-cols (grid) can flex into the
     full available height. Without this, .pl-editor-cols had no bounded
     parent height and inner overflow:auto never fired. */
  display: flex; flex-direction: column;
}
.pl-modal-footer {
  padding: .75rem 1.25rem;
  border-top: 1px solid var(--rule);
  display: flex; justify-content: flex-end; gap: .5rem;
}

.pl-editor-cols {
  flex: 1 1 auto; min-height: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
  overflow: hidden;
}
@media (max-width: 720px) {
  /* On mobile, abandon the inner-scroll-container model entirely. Two
     scrolling boxes side-by-side don't fit, and stacked scroll boxes inside
     a fixed modal create a scroll-trap (touch scroll easily lands on the
     wrong layer). Instead: let the modal-body scroll the whole content,
     and let lists flow at their natural height. */
  .pl-editor-cols {
    grid-template-columns: 1fr;
    gap: 1rem;
    height: auto;
    overflow: visible;
  }
  .pl-modal-body { overflow: auto; -webkit-overflow-scrolling: touch; }
  .pl-editor-left, .pl-editor-right { overflow: visible; min-height: 0; }
  .pl-selected-list, .pl-available-list { overflow: visible; flex: 0 0 auto; }
}

.pl-editor-left,
.pl-editor-right {
  display: flex; flex-direction: column;
  min-height: 0;
  overflow: hidden;
}

/* Meta grid (title/artist/year/kind/cover) */
.pl-meta-grid {
  display: grid; gap: .5rem .75rem;
  grid-template-columns: 1fr 1fr;
  margin-bottom: 1rem;
}
.pl-field { display: flex; flex-direction: column; gap: .25rem; }
/* `display: flex` wint van het hidden-attribuut, dus zonder deze regel doet
   [hidden] op een .pl-field NIETS -- het veld blijft gewoon staan. De
   uitgavevelden schakelen daarop (album versus afspeellijst). */
.pl-field[hidden] { display: none; }
.pl-field-full { grid-column: 1 / -1; }
.pl-field > span {
  font-size: .8rem; color: var(--ink-soft); font-weight: 500;
}
.pl-field input,
.pl-field select {
  width: 100%;
  padding: .5rem .75rem;
  border: 1px solid var(--rule); border-radius: 8px;
  background: var(--paper); color: var(--ink);
  font-family: var(--font-ui); font-size: .95rem;
}
.pl-field input:focus,
.pl-field select:focus { outline: 2px solid var(--accent); outline-offset: -1px; }

.pl-cover-row {
  display: flex; align-items: center; gap: .5rem;
}
.pl-cover-thumb {
  width: 48px; height: 48px; border-radius: 8px;
  background: var(--paper-2);
  border: 1px solid var(--rule);
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; padding: 0; overflow: hidden;
}
.pl-cover-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.pl-cover-empty { font-size: 1.25rem; color: var(--ink-muted); }

/* File upload row + status — only renders in edit mode */
.pl-cover-upload-row {
  display: flex; align-items: center; gap: .5rem;
  margin-top: .35rem; flex-wrap: wrap;
}
.pl-btn-small {
  background: var(--paper-2); color: var(--ink);
  border: 1px solid var(--rule); border-radius: 999px;
  padding: .35rem .75rem; font-size: .8rem;
  cursor: pointer; transition: border-color 120ms;
  -webkit-tap-highlight-color: transparent;
}
.pl-btn-small:hover { border-color: var(--accent); }
.pl-cover-status { font-size: .8rem; color: var(--ink-muted); }
.pl-cover-status.is-error { color: #dc2626; }
.pl-cover-status.is-ok    { color: #2a9d5e; }
.pl-cover-note { font-size: .75rem; color: var(--ink-muted); margin-top: .25rem; display: block; }

/* Section titles */
.pl-section-title {
  display: flex; align-items: baseline; gap: .5rem;
  font-size: .8rem; font-weight: 600;
  text-transform: uppercase; letter-spacing: .05em;
  color: var(--ink-soft);
  padding: .5rem 0;
  margin-bottom: .5rem;
  border-bottom: 1px solid var(--rule);
  flex-shrink: 0;
}
.pl-section-title small {
  font-size: .8em; font-weight: 400; text-transform: none; letter-spacing: 0;
  color: var(--ink-muted);
}
.pl-track-count {
  background: var(--accent); color: #fff;
  padding: .1em .55em; border-radius: 999px; font-size: .75rem;
  font-weight: 600; margin-left: .25rem;
}

/* Selected + available lists */
.pl-selected-list,
.pl-available-list {
  flex: 1; overflow-y: auto; min-height: 0;
  padding-right: .25rem;
}
.pl-empty {
  color: var(--ink-muted); font-style: italic;
  padding: 1.5rem; text-align: center; font-size: .9rem;
}

/* Search input on right pane */
.pl-search-input {
  width: 100%;
  padding: .5rem .75rem;
  border: 1px solid var(--rule); border-radius: 8px;
  background: var(--paper); color: var(--ink);
  font-family: var(--font-ui); font-size: .9rem;
  margin-bottom: .5rem;
  flex-shrink: 0;
}

/* Selected row (sortable) */
.pl-row {
  display: flex; align-items: center; gap: .5rem;
  padding: .5rem;
  border: 1px solid transparent;
  border-radius: 8px;
  margin-bottom: .25rem;
  background: var(--paper-2);
  user-select: none;
}
.pl-row.is-dragging { opacity: 0.5; }
.pl-row.drop-above { box-shadow: 0 -2px 0 var(--accent); }
.pl-row.drop-below { box-shadow: 0 2px 0 var(--accent); }
.pl-row-handle {
  cursor: grab; padding: .25rem .5rem;
  color: var(--ink-muted);
  touch-action: none;
}
.pl-row-handle:active { cursor: grabbing; }
.pl-row-num {
  width: 22px; text-align: right;
  font-family: var(--font-mono, monospace);
  font-size: .8rem; color: var(--ink-muted);
}
.pl-row-cover {
  width: 32px; height: 32px; border-radius: 4px;
  flex-shrink: 0;
  background: var(--paper); border: 1px solid var(--rule);
  display: inline-flex; align-items: center; justify-content: center;
  overflow: hidden;
}
.pl-row-cover img { width: 100%; height: 100%; object-fit: cover; }
.pl-row-cover-empty { color: var(--ink-muted); font-size: .8rem; }
.pl-row-info {
  flex: 1; min-width: 0;
  display: flex; flex-direction: column;
  font-size: .85rem;
}
.pl-row-title {
  font-weight: 500;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.pl-row-artist {
  font-size: .8em; color: var(--ink-soft);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.pl-row-x {
  background: transparent; border: 0;
  width: 28px; height: 28px;
  border-radius: 6px;
  cursor: pointer;
  color: var(--ink-muted);
  font-size: 1.1rem;
}
.pl-row-x:hover { background: var(--paper); color: #dc2626; }

/* Available row (clickable) */
.pl-avail-row {
  display: flex; align-items: center; gap: .5rem;
  padding: .5rem; border-radius: 8px;
  cursor: pointer; margin-bottom: .25rem;
  transition: background 120ms ease;
}
.pl-avail-row:hover { background: var(--paper-2); }
.pl-avail-row.is-added { opacity: .55; }
.pl-avail-row.is-unplayable { opacity: .4; cursor: not-allowed; }
.pl-avail-action {
  width: 22px; height: 22px;
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-size: .9rem; font-weight: 600;
  background: var(--paper-2); color: var(--ink-soft);
  flex-shrink: 0;
}
.pl-avail-row.is-added .pl-avail-action {
  background: var(--accent); color: #fff;
}

/* Cover-picker grid (sub-modal) */
.pl-cover-picker-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
  gap: .5rem; max-height: 60vh; overflow-y: auto;
}
.pl-cover-picker-grid button {
  border: 1px solid var(--rule); border-radius: 8px;
  background: var(--paper-2); padding: 0; cursor: pointer;
  aspect-ratio: 1; overflow: hidden;
}
.pl-cover-picker-grid button:hover { border-color: var(--accent); }
.pl-cover-picker-grid img { width: 100%; height: 100%; object-fit: cover; display: block; }
</style>

<%# Het script staat in assets/js/mod/playlist-editor.js; de gegevens via partials/page-data.ejs (shaer-bqr). %>
