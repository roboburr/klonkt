<%
// Track editor modal — mobile-first rewrite.
//
// Visual model:
//   Mobile (<720px): bottom-sheet that slides up from below, max 92vh,
//                    rounded top corners only, drag-handle bar at top.
//   Desktop (≥720px): centered modal max-width 520px, fully-rounded.
//
// Self-contained styling under the .te-* namespace — no dependency on
// the .ax-* admin primitives. Same visual language though: paper bg,
// rule borders, accent for active states.
//
// Exposes window.openTrackEditor({ id, onSaved? }) — called by the
// "✎ Bewerken" buttons on admin-audio. Fetches /admin/audio/api/:id,
// renders the form with current values + an inline <audio> preview,
// and PATCHes via /admin/audio/api/:id on save.

const _csrf = (typeof csrfToken !== 'undefined' && csrfToken) || '';
%>

<style>
/* ─────────────────────────────────────────────────────────────────
   Track editor modal — namespace .te-*
   ───────────────────────────────────────────────────────────────── */

.te-backdrop {
  position: fixed; inset: 0;
  /* Above bottom-tab nav (z=1050) and audio-player sheet (z=1100) so the
     editor always wins. */
  z-index: 9000;
  background: rgba(0, 0, 0, 0.55);
  -webkit-backdrop-filter: blur(4px);
  backdrop-filter: blur(4px);
  display: flex;
  /* Mobile: dock to bottom; desktop overrides to center via media query */
  align-items: flex-end;
  justify-content: center;
  animation: te-fade 160ms ease-out;
}
@keyframes te-fade { from { opacity: 0; } to { opacity: 1; } }

.te-modal {
  background: var(--paper);
  width: 100%;
  max-height: 92vh;
  /* Bottom-sheet shape on mobile — only top corners rounded */
  border-radius: 16px 16px 0 0;
  border: 1px solid var(--rule);
  border-bottom: 0;
  box-shadow: 0 -8px 30px rgba(0,0,0,0.4);
  display: flex; flex-direction: column;
  overflow: hidden;
  animation: te-slide-up 220ms cubic-bezier(.2,.9,.3,1);
}
@keyframes te-slide-up {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}

/* Desktop: center the modal as a card */
@media (min-width: 720px) {
  .te-backdrop { align-items: center; padding: 1rem; }
  .te-modal {
    max-width: 520px;
    border-radius: 14px;
    border: 1px solid var(--rule);
    max-height: calc(100vh - 2rem);
    box-shadow: 0 20px 60px rgba(0,0,0,0.4);
    animation: te-fade 220ms ease-out;
  }
}

/* Drag-handle bar at top of mobile sheet */
.te-handle {
  width: 100%; padding: 0.6rem 0;
  display: flex; justify-content: center;
  flex-shrink: 0;
}
.te-handle-bar {
  width: 36px; height: 4px;
  background: var(--rule);
  border-radius: 99px;
}
@media (min-width: 720px) { .te-handle { display: none; } }

.te-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0.5rem 1.25rem 1rem;
  border-bottom: 1px solid var(--rule);
  flex-shrink: 0;
}
@media (min-width: 720px) { .te-header { padding: 1rem 1.25rem; } }
.te-header h3 {
  font-family: var(--font-display, serif);
  margin: 0; font-size: 1.15rem; font-weight: 600;
}
.te-close {
  width: 36px; height: 36px;
  display: inline-flex; align-items: center; justify-content: center;
  border: 0; border-radius: 8px;
  background: transparent;
  color: var(--ink-muted, var(--ink-soft));
  font-size: 1.5rem; line-height: 1;
  cursor: pointer;
  transition: background 120ms, color 120ms;
}
.te-close:hover { background: var(--paper-2); color: var(--ink); }

.te-body {
  padding: 1rem 1.25rem;
  overflow-y: auto;
  flex: 1;
  -webkit-overflow-scrolling: touch;
  display: flex; flex-direction: column; gap: 1rem;
}

/* ── Inline preview player ─────────────────────────────────── */
.te-preview {
  display: flex; align-items: center; gap: 0.75rem;
  padding: 0.75rem;
  background: var(--paper-2);
  border: 1px solid var(--rule);
  border-radius: 10px;
}
.te-preview-cover {
  width: 56px; height: 56px;
  border-radius: 8px; overflow: hidden;
  background: var(--paper);
  display: inline-flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  font-size: 1.4rem; color: var(--accent);
}
.te-preview-cover img { width: 100%; height: 100%; object-fit: cover; }
.te-preview-meta {
  flex: 1; min-width: 0;
  display: flex; flex-direction: column; gap: 0.25rem;
}
.te-preview-title {
  font-weight: 600; font-size: 0.95rem;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.te-preview-sub {
  font-size: 0.78rem;
  color: var(--ink-muted, var(--ink-soft));
}
.te-preview-play {
  width: 44px; height: 44px;
  border: 1px solid var(--rule);
  border-radius: 50%;
  background: var(--paper);
  color: var(--ink);
  font-size: 1.1rem;
  cursor: pointer;
  display: inline-flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  transition: border-color 120ms, color 120ms, background 120ms;
}
.te-preview-play:hover { border-color: var(--accent); color: var(--accent); }
.te-preview-play.is-playing {
  background: var(--accent); color: white; border-color: var(--accent);
}

/* ── Form fields ───────────────────────────────────────────── */
.te-form { display: flex; flex-direction: column; gap: 0.85rem; }
.te-row { display: grid; gap: 0.85rem; }
.te-row-2 { grid-template-columns: 1fr 1fr; }
@media (max-width: 480px) { .te-row-2 { grid-template-columns: 1fr; } }

.te-field { display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; }
.te-field > span {
  font-size: 0.8rem; font-weight: 600;
  color: var(--ink-soft);
  display: flex; align-items: baseline; gap: 0.4rem;
}
.te-field > span small {
  font-weight: 400; color: var(--ink-muted); font-size: 0.95em;
}
.te-required { color: #dc2626; }
.te-field input[type="text"],
.te-field input[type="number"],
.te-field input[type="url"] {
  width: 100%; box-sizing: border-box;
  padding: 0.6rem 0.75rem; min-height: 44px;
  border: 1px solid var(--rule); border-radius: 6px;
  background: var(--paper-2); color: var(--ink);
  font-family: var(--font-ui, system-ui), sans-serif;
  font-size: 0.95rem;
  -webkit-appearance: none; appearance: none;
  transition: border-color 120ms;
}
.te-field input:focus {
  outline: 2px solid var(--accent);
  outline-offset: -1px;
  border-color: var(--accent);
}

/* ── Credit field with © insert button ──────────────────────────── */
.te-credit-row { display: flex; gap: 0.4rem; align-items: stretch; }
.te-credit-row input { flex: 1; min-width: 0; }
.te-sym-btn {
  flex: 0 0 auto;
  width: 44px; min-height: 44px;
  border: 1px solid var(--rule); border-radius: 6px;
  background: var(--paper-2); color: var(--ink);
  font-size: 1.1rem; cursor: pointer;
  transition: border-color 120ms, background 120ms;
}
.te-sym-btn:hover { border-color: var(--accent); }

/* ── Cover field with thumb + button + URL ─────────────────── */
.te-cover-row {
  display: grid;
  grid-template-columns: 80px 1fr;
  gap: 0.75rem;
  align-items: start;
}
.te-cover-thumb {
  width: 80px; height: 80px;
  border-radius: 10px;
  border: 1px dashed var(--rule);
  background: var(--paper-2);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  cursor: pointer;
  transition: border-color 120ms;
}
.te-cover-thumb:hover, .te-cover-thumb.is-dragover { border-color: var(--accent); border-style: solid; }
.te-cover-thumb img { width: 100%; height: 100%; object-fit: cover; }
.te-cover-empty {
  font-size: 1.6rem; opacity: 0.5;
}
.te-cover-actions {
  display: flex; flex-direction: column; gap: 0.5rem;
  min-width: 0;
}
.te-cover-btn-row { display: flex; gap: 0.4rem; flex-wrap: wrap; }
.te-cover-btn {
  display: inline-flex; align-items: center; gap: 0.35rem;
  padding: 0.45rem 0.75rem;
  border: 1px solid var(--rule); border-radius: 6px;
  background: var(--paper-2); color: var(--ink);
  font-family: var(--font-ui, system-ui); font-size: 0.85rem;
  cursor: pointer;
  transition: border-color 120ms;
}
.te-cover-btn:hover { border-color: var(--accent); }
.te-cover-btn-remove:hover { color: #dc2626; border-color: #dc2626; }
.te-cover-status {
  font-size: 0.78rem;
  color: var(--ink-muted, var(--ink-soft));
  min-height: 1em;
}
.te-cover-status.is-error { color: #dc2626; }
.te-cover-status.is-ok { color: #2a9d5e; }

/* ── Footer (sticky) ───────────────────────────────────────── */
.te-footer {
  display: flex; align-items: center; gap: 0.5rem;
  padding: 0.85rem 1.25rem;
  border-top: 1px solid var(--rule);
  background: var(--paper);
  flex-shrink: 0;
}
.te-footer-spacer { flex: 1; }
.te-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 0.35rem;
  padding: 0.6rem 1.1rem; min-height: 44px;
  border: 1px solid var(--rule); border-radius: 8px;
  background: var(--paper-2); color: var(--ink);
  font-family: var(--font-ui, system-ui); font-size: 0.9rem; font-weight: 500;
  cursor: pointer;
  transition: border-color 120ms, background 120ms;
  -webkit-tap-highlight-color: transparent;
}
.te-btn:hover { border-color: var(--accent); }
.te-btn:disabled { opacity: 0.5; cursor: not-allowed; }
.te-btn-primary {
  background: var(--accent); color: white; border-color: var(--accent);
}
.te-btn-primary:hover { opacity: 0.92; }

/* Lock body scroll while modal is open */
body.te-modal-open { overflow: hidden; }
</style>

